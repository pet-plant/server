meta {
  name: 01 Trigger Pipeline Run
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orchestrator/runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "plant_id": "{{plantId}}"
  }
}

assert {
  res.status: in [201, 200]
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("runId", res.body.id);
  }
}
