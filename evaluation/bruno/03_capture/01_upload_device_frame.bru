meta {
  name: 01 Upload Device Frame (Planter Upload)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/capture/devices/me/frames
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{deviceToken}}
}

body:multipart-form {
  image: @file(../evaluation/datasets/images/monstera_yellowing.jpg)
}

assert {
  res.status: eq 201
  res.body.capture_id: isDefined
  res.body.quality_passed: eq true
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("captureId", res.body.capture_id);
  }
}
