meta {
  name: 02 Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/token
  body: form-urlencoded
  auth: none
}

body:form-urlencoded {
  username: {{userEmail}}
  password: {{userPassword}}
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("userToken", res.body.access_token);
  }
}
