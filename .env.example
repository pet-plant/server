# Pet-Plant server — environment variables (template)
# Owned by the `core` context. Copy to `.env` and fill in.
# Names are indicative and will be finalised as `core` config lands.

# --- app ---
APP_ENV=local  # local | dev | staging | prod
LOG_LEVEL=INFO

# --- PostgreSQL (single instance, one schema per context) ---
DATABASE_URL=postgresql+psycopg://petplant:petplant@localhost:5432/petplant

# --- MinIO / S3 ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_CAPTURES=captures
MINIO_BUCKET_FRAMES_DERIVED=frames-derived
MINIO_BUCKET_EXEMPLARS=exemplars
MINIO_BUCKET_EVAL_SETS=eval-sets

# --- auth (OAuth2 / JWT, role-based) ---
JWT_ISSUER=pet-plant
JWT_AUDIENCE=pet-plant-api
JWT_ALG=HS256
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=3600

# --- self-hosted inference (on-prem, called over the network; models not in this repo) ---
# VLM served with vLLM, OpenAI-compatible API
VLM_API_BASE=http://localhost:8001/v1
VLM_API_KEY=
VLM_MODEL=
SEGMENTATION_ENDPOINT=http://localhost:8100

# --- external LLM for advice / offline script generation (text only; never images) ---
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# --- ClearML (self-hosted) ---
CLEARML_API_HOST=
CLEARML_WEB_HOST=
CLEARML_FILES_HOST=
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
